RAEBURN_ENV=development
RAEBURN_PUBLIC_BASE_URL=http://localhost:3000
RAEBURN_API_BASE_URL=http://localhost:8080
RAEBURN_API_KEY=change-me-use-a-secret-manager-in-production
RAEBURN_BOOTSTRAP_WORKSPACE_ID=default
# Optional Base32 TOTP secret for bootstrap-admin MFA. Keep real secrets in a secret manager.
RAEBURN_BOOTSTRAP_TOTP_SECRET=
# Optional additional workspace-scoped API credentials. Add totp_secret to require MFA for that principal.
# Example shape: {"<api-key>":{"workspace_id":"acme","role":"approver","subject":"alice@example.com","totp_secret":"BASE32SECRET"}}
RAEBURN_WORKSPACE_API_KEYS={}
# Production writebacks read credentials only from the durable job's workspace.
# Example (redacted): {"acme":{"email":{"host":"smtp.example.com","port":587,"username":"mailer@example.com","password":"secret","from_address":"mailer@example.com","starttls":true}}}
RAEBURN_WORKSPACE_INTEGRATIONS={}
RAEBURN_SECRETS_KEY=change-me-32-byte-minimum
RAEBURN_CORS_ORIGINS=http://localhost:3000
RAEBURN_RATE_LIMIT_PER_MINUTE=60
RAEBURN_RATE_LIMIT_MAX_CLIENTS=10000
MEETING_RETENTION_SECONDS=2592000
DATABASE_URL=postgresql+psycopg://raeburn:raeburn@postgres:5432/meeting_intelligence
REDIS_URL=redis://redis:6379/0

# LLM provider: deterministic | openai_compatible
LLM_PROVIDER=deterministic
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=gpt-4.1-mini

# Integrations are disabled until explicitly enabled. Global credentials below are
# development-only fallbacks; production requires RAEBURN_WORKSPACE_INTEGRATIONS.
GITHUB_WRITEBACK_ENABLED=false
GITHUB_TOKEN=
GITHUB_DEFAULT_REPOSITORY=

JIRA_WRITEBACK_ENABLED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

CRM_WRITEBACK_ENABLED=false
CRM_PROVIDER=hubspot
CRM_API_KEY=

# Production email requires per-workspace authenticated SMTP with STARTTLS=true.
EMAIL_FOLLOWUP_ENABLED=false

WEBHOOK_WRITEBACK_ENABLED=false
WEBHOOK_URL=
# Required whenever WEBHOOK_WRITEBACK_ENABLED=true in development fallback mode.
WEBHOOK_SIGNING_SECRET=

APPROVALS_REQUIRED=true
AUDIT_LOG_LEVEL=INFO